# Environment Variables

# Database Configuration (REQUIRED - change these in production!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-use-strong-password
POSTGRES_DB=sre_platform
DATABASE_URL=postgresql://postgres:postgres@db:5432/sre_platform

# Grafana Configuration (REQUIRED - change in production!)
GRAFANA_ADMIN_PASSWORD=change-me-use-strong-password

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-production-domain.com

# Backend Configuration
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
DEBUG=false
HOST=0.0.0.0
PORT=8000
